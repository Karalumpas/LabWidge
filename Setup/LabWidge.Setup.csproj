<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The LabWidge installer.
    Built for .NET Framework 4.8, which is part of Windows 10/11, so it can run before .NET 8 is installed.
    The app (dist\app\LabWidge.exe) is embedded as a resource – build it first (see install.ps1).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>LabWidge-Setup</AssemblyName>
    <RootNamespace>LabWidgeSetup</RootNamespace>
    <ApplicationIcon>..\LabWidge\Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.16.0</Version>
    <Product>LabWidge</Product>
    <AssemblyTitle>LabWidge Setup</AssemblyTitle>
    <DebugType>none</DebugType>
    <AppPackagePath>$(MSBuildThisFileDirectory)..\dist\app.zip</AppPackagePath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <!-- The same English/Danish texts helper as the app -->
    <Compile Include="..\LabWidge\Localization.cs" Link="Localization.cs" />
    <!-- The country list, so the installer can ask for the country -->
    <Compile Include="..\LabWidge\Countries.cs" Link="Countries.cs" />
    <EmbeddedResource Include="..\LabWidge\Assets\app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="$(AppPackagePath)" LogicalName="app.zip" Condition="Exists('$(AppPackagePath)')" />
  </ItemGroup>
  <Target Name="RequireAppPackage" BeforeTargets="Build" Condition="!Exists('$(AppPackagePath)')">
    <Error Text="dist\app.zip is missing. Run install.ps1, which builds and packs the app before Setup." />
  </Target>
</Project>
