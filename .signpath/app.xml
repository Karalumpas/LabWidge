<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="LabWidge.exe" product-name="LabWidge" product-version="${version}" file-version="${version}.0">
      <authenticode-sign />
    </pe-file>
    <pe-file path="LabWidge.dll" product-name="LabWidge" product-version="${version}" file-version="${version}.0">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
